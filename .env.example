# Loop interval (seconds)
MONITOR_INTERVAL=60

# AWS
AWS_REGION=ap-south-1
WAF_SCOPE=REGIONAL

# WAF S3 logs
WAF_LOG_BUCKET=aws-waf-logs-cv3
WAF_LOG_PREFIX=AWSLogs/231322554539/WAFLogs/ap-south-1/WAF-CV3/

# Client IP registry (S3 JSON: {"52.74.226.127/32": "SALMON"})
REGISTRY_S3_KEY=config/waf-ip-clients.json

# Debug temp allow IP set
DEBUG_IP_SET_NAME=debug-temp-allow
DEBUG_IP_SET_ID=replace-with-your-ip-set-id

# Thresholds
BLOCK_THRESHOLD=10
BLOCK_WINDOW_MINUTES=30
DEBUG_EXPIRE_MINUTES=5
HITS_TO_REMOVE=1

# ELK
ELK_URL=https://your-elk:9200
ELK_INDEX=nginx-*
ELK_USER=
ELK_PASSWORD=
ELK_VERIFY_SSL=true

# Slack (optional)
SLACK_WEBHOOK_URL=

# Local state file (persist in Docker volume)
STATE_FILE=/data/state.json
