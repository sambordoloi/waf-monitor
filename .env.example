# Loop interval (seconds)
MONITOR_INTERVAL=60

# AWS
AWS_REGION=ap-south-1
WAF_SCOPE=REGIONAL

# WAF log source (default: cloudwatch for fast ALLOW detection)
LOG_SOURCE=cloudwatch
# Required when LOG_SOURCE=cloudwatch — your WAF CloudWatch log group name
CLOUDWATCH_LOG_GROUP=

# S3 fallback (set LOG_SOURCE=s3)
WAF_LOG_BUCKET=aws-waf-logs-cv3
WAF_LOG_PREFIX=AWSLogs/231322554539/WAFLogs/ap-south-1/WAF-CV3/

# Client IP registry — optional names for Slack (S3 JSON)
REGISTRY_S3_KEY=config/waf-ip-clients.json
# Legacy: if true, only /api/token/ blocks from registry IPs are monitored
REGISTRY_ONLY=false

# Debug temp allow IP set
DEBUG_IP_SET_NAME=debug_temp_allow_ip
DEBUG_IP_SET_ID=b4cf1530-b0c9-44b9-9c7f-a99a36bf56e4

# Poll every N seconds while a debug session is active (default 5s)
ACTIVE_POLL_INTERVAL=5
BLOCK_THRESHOLD=10
BLOCK_WINDOW_MINUTES=30
DEBUG_EXPIRE_MINUTES=5
HITS_TO_REMOVE=1

# CV3 nginx backend log (mount same path in docker-compose)
APP_LOG_PATH=/var/log/nginx/backend/access_api.log
APP_LOG_TAIL_MB=50

# ELK fallback (optional if APP_LOG_PATH is set)
ELK_URL=https://your-elk:9200
ELK_INDEX=cv2*
ELK_USER=
ELK_PASSWORD=
ELK_VERIFY_SSL=true
ELK_WINDOW_MINUTES=60

# Slack (optional)
SLACK_WEBHOOK_URL=

# Local state file (persist in Docker volume)
STATE_FILE=/data/state.json
